NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Used only for direct browser -> Supabase Storage uploads (see
# lib/supabase/direct-upload.ts). The anon key is safe to ship to the
# browser: it has no Storage write access on its own, only the one-time
# signed token the backend issues for an exact path does.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
